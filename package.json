{
  "name": "lalocord",
  "version": "2.2.0",
  "description": "P2P streaming and chating",
  "author": {
    "name": "Nikita Ozhegov",
    "email": "nikita.ozhegov8@mail.ru"
  },
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  },
  "repository": "github:Kaptoiiika/lalocord",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "postinstall": "node scripts/ensure-native-bindings.mjs",
    "install:electron": "npm i --include=optional",
    "electron:dev": "vite --mode electron",
    "electron:build": "vite build --mode electron && electron-builder",
    "electron:preview": "vite build --mode electron && electron .",
    "test": "vitest",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "stylelint:fix": "stylelint --fix **/*.scss",
    "prettier": "prettier src/**/*.{js,jsx,ts,tsx,css,md,json} --check",
    "prettier:fix": "prettier src/**/*.{js,jsx,ts,tsx} --write ",
    "prettier-lint": "npm run prettier && npm run lint",
    "format": "npm run prettier:fix && npm run lint:fix"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.66.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-linkify": "^1.0.0-alpha",
    "react-router-dom": "^7.18.5",
    "shadcn": "^4.23.0",
    "socket.io-client": "^4.8.4",
    "swr": "^2.5.1",
    "tw-animate-css": "^1.4.0",
    "web-vitals": "^6.2.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-linkify": "^1.0.4",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.2.1",
    "css-loader": "^7.1.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "file-loader": "^6.2.0",
    "prettier": "^3.9.10",
    "sass": "1.107.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-svgr": "^5.2.0",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "optionalDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-context-menu": "^4.1.2",
    "vite-plugin-electron": "^1.2.0",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@babel/runtime": "7.29.10",
    "@babel/plugin-transform-runtime": "7.29.7"
  },
  "build": {
    "appId": "com.lalocord.app",
    "productName": "Lalocord",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!**/node_modules/**",
      "node_modules/@nut-tree-fork/libnut-win32/**/*",
      "node_modules/@nut-tree-fork/libnut-linux/**/*",
      "node_modules/@nut-tree-fork/libnut-darwin/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "Kaptoiiika",
      "repo": "lalocord"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/logo512.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/logo512.png"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}